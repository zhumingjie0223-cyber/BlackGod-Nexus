{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "words"
  ],
  "properties": {
    "_meta": {
      "type": "object"
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word_id",
          "english",
          "zh",
          "signbank_id_gloss",
          "source_dataset",
          "license",
          "is_commercial_ok",
          "handedness",
          "notes",
          "unverified"
        ],
        "properties": {
          "word_id": {
            "type": "string",
            "pattern": "^asl_w_[0-9]{3}$"
          },
          "english": {
            "type": "string",
            "minLength": 1
          },
          "zh": {
            "type": "string",
            "minLength": 1
          },
          "signbank_id_gloss": {
            "type": [
              "string",
              "null"
            ]
          },
          "signbank_status": {
            "type": "string"
          },
          "source_dataset": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "is_commercial_ok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "handedness": {
            "enum": [
              "one",
              "two",
              "unknown"
            ]
          },
          "unverified": {
            "type": "boolean"
          },
          "verified_source": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}