// 草案（未编译：box 上无 swift 工具链）。与 skill_market.py 行为一一对应，供 ios-app 接入 NexusSkillStore.save 时实现。
import Foundation
import CryptoKit

enum GateVerdict: String, Codable { case pass = "PASS", fail = "FAIL", notReady = "NOT_READY" }

struct SkillCapability: Codable, Equatable { let id: String; let domains: [String]? }
struct SkillFileEntry: Codable, Equatable { let path: String; let sha256: String; let size: Int? }
struct EvalHash: Codable, Equatable { let testset_lock_sha256: String; let gate_config_sha256: String; let gate_report_sha256: String }

struct SkillManifest: Codable {
    let pack_id: String, kind: String, version: String, group: String   // group: skills | experimental
    let channel: String?, author_key_fingerprint: String                 // sha256(raw 32B pubkey)
    let capabilities: [SkillCapability], files: [SkillFileEntry]
    let eval_hash: EvalHash?
    let signature: String                                                 // base64 Ed25519 over canonicalJSON(manifest - signature)
}

struct ActivationResult { let verdict: GateVerdict; let reason: String; let packID: String?; let version: String? }
struct VersionPointer: Codable, Equatable { var current: String?; var previous: String? }

protocol SkillPackVerifier {
    func canonicalJSON(_ object: Any) throws -> Data               // 键排序、无空白、拒绝浮点、删注释键
    func verifySignature(_ m: SkillManifest, raw: Data, trusted: [Curve25519.Signing.PublicKey]) throws
    func checkCapabilities(_ caps: [SkillCapability]) throws       // 白名单；allowDangerous / shell / 跨技能 / 无域名网络 -> FAIL
    func verifyFiles(_ m: SkillManifest, packageRoot: URL) throws  // 符号链接、../、绝对路径、多余/缺失/哈希不符 -> FAIL
    func checkEvalHash(_ m: SkillManifest, expected: EvalHash?) throws // 缺 -> NOT_READY，不符 -> FAIL
}

protocol SkillPackStore {
    typealias RunGates = (SkillManifest, URL) -> GateVerdict
    init(root: URL, trustedKeys: [Curve25519.Signing.PublicKey])   // 公钥打进 App 二进制，由调用方传入
    func activate(packageAt: URL, expectedEvalHash: EvalHash?, runGates: RunGates) -> ActivationResult
    func rollback(packID: String) -> ActivationResult
    func pointer(packID: String) -> VersionPointer                 // 原子写：临时文件 + fsync + rename
    var logURL: URL { get }                                        // activation_log.jsonl
}
